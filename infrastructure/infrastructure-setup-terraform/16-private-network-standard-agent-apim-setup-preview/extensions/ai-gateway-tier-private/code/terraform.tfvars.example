# Copy to terraform.tfvars. Only subscription_id is required.

subscription_id = "00000000-0000-0000-0000-000000000000"

# Optional overrides (defaults shown):
# location                  = "swedencentral"  # eastus2 or swedencentral; everything deploys here
# name_prefix               = "aigwpriv"
# foundry_allowed_ip_ranges = []               # e.g. ["203.0.113.10"] to run the agent script from your machine
# foundry_public_network_access_enabled = false # open the agent account to all networks for testing (Entra auth still required)
# model_name                = "gpt-5.4"
# model_version             = "2026-03-05"
# model_capacity            = 1
# tokens_per_minute         = 100
# connection_name           = "ai-gateway"
# credential_version        = "1"              # bump after rotating the gateway key
# assign_foundry_user_role  = true
# auth_header_name          = "Authorization"
# auth_header_format        = "Bearer {api_key}"

# Networking (defaults shown):
# virtual_network_address_space          = "192.168.0.0/16"
# agent_subnet_address_prefix            = "192.168.0.0/24"
# private_endpoint_subnet_address_prefix = "192.168.1.0/24"
# gateway_subnet_address_prefix          = "192.168.2.0/24"
