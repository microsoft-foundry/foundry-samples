# A custom header for the key, plus custom request headers.
# Same inputs as the Bicep sample infrastructure-setup-bicep/01-connections/model-gateway/samples/parameters-custom-auth-config.json.
#
# Copy this file to terraform.tfvars and replace the YOUR-... values.
# Set the API key in the TF_VAR_api_key environment variable, not in this file.

project_resource_id = "/subscriptions/YOUR-SUBSCRIPTION-ID/resourceGroups/YOUR-RG/providers/Microsoft.CognitiveServices/accounts/YOUR-AI-FOUNDRY-ACCOUNT/projects/YOUR-PROJECT"
target_url          = "YOUR-MODEL-GATEWAY-URL"
gateway_name        = "YOUR-GATEWAY-NAME"
connection_name     = "YOUR-CONNECTION-NAME"
auth_type           = "ApiKey"
is_shared_to_all    = false

static_models = [
  {
    name = "gpt-4o-deployment"
    properties = {
      model = {
        name    = "gpt-4o"
        version = "2024-08-06"
        format  = "OpenAI"
      }
    }
  },
  {
    name = "gpt-4o-mini-deployment"
    properties = {
      model = {
        name    = "gpt-4o-mini"
        version = "2024-07-18"
        format  = "OpenAI"
      }
    }
  },
]

deployment_in_path = false

auth_config = {
  type   = "api_key"
  name   = "Authorization"
  format = "Bearer {api_key}"
}

custom_headers = {
  "YOUR-HEADER-NAME-1" = "YOUR-HEADER-VALUE-1"
  "YOUR-HEADER-NAME-2" = "YOUR-HEADER-VALUE-2"
}
