# Provider requirements for sample 48 (hub -> gateway -> spoke with a private-CA
# gateway behind private DNS). A single subscription hosts both VNets: the
# platform hub (gateway, APIM, model, PKI, DNS) and the workload spoke
# (VNet-injected Foundry account and its data proxy).
terraform {
  required_providers {
    azapi = {
      source  = "azure/azapi"
      version = "~> 2.5"
    }
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.37"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.7"
    }
    time = {
      source  = "hashicorp/time"
      version = "~> 0.13"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
    # Packages the gateway certificate + chain as the PFX Application Gateway
    # requires. Community provider; Terraform has no built-in PKCS#12 support.
    pkcs12 = {
      source  = "chilicat/pkcs12"
      version = "~> 0.4"
    }
  }
  required_version = ">= 1.10.0, < 2.0.0"

  # Uncomment to store state in Azure Storage. Remote state is recommended
  # because the private root CA and gateway private keys are generated by
  # Terraform and stored in state.
  # backend "azurerm" {}
}
