{
  "parameters": {
    "location": {
      "type": "String"
    },
    "config": {
      "type": "Object"
    }
  },
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "resources": [
    {
      "properties": {
        "subnets": [
          {
            "name": "[parameters('config').agentSubnetName]",
            "properties": {
              "delegations": [
                {
                  "name": "agent-delegation",
                  "properties": {
                    "serviceName": "Microsoft.App/environments"
                  }
                }
              ],
              "addressPrefix": "[parameters('config').agentSubnetPrefix]"
            }
          },
          {
            "name": "[parameters('config').privateEndpointSubnetName]",
            "properties": {
              "addressPrefix": "[parameters('config').privateEndpointSubnetPrefix]",
              "privateEndpointNetworkPolicies": "Disabled"
            }
          }
        ],
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('config').addressPrefix]"
          ]
        }
      },
      "type": "Microsoft.Network/virtualNetworks",
      "name": "[parameters('config').vnetName]",
      "apiVersion": "2024-05-01",
      "location": "[parameters('location')]"
    }
  ],
  "outputs": {
    "privateEndpointSubnetResourceId": {
      "type": "String",
      "value": "[format('{0}/subnets/{1}', resourceId('Microsoft.Network/virtualNetworks', parameters('config').vnetName), parameters('config').privateEndpointSubnetName)]"
    },
    "agentSubnetResourceId": {
      "type": "String",
      "value": "[format('{0}/subnets/{1}', resourceId('Microsoft.Network/virtualNetworks', parameters('config').vnetName), parameters('config').agentSubnetName)]"
    }
  },
  "contentVersion": "1.0.0.0"
}
