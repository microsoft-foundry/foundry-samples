<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Voice Agents (Azure.AI.Projects.Agents) and the realtime client (Azure.AI.Projects) are preview features. -->
        <NoWarn>$(NoWarn);AAIP001;AAIP002;OPENAI002</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Azure.AI.Projects" Version="3.0.0-beta.3" />
        <PackageReference Include="Azure.AI.Projects.Agents" Version="3.0.0-beta.3" />
        <PackageReference Include="OpenAI" Version="2.14.0" />
        <PackageReference Include="Azure.Identity" Version="1.21.0" />
    </ItemGroup>

    <ItemGroup>
        <None Update="assets\input.pcm">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
