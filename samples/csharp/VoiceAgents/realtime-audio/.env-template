# Standard Microsoft Foundry environment variable names, used for scaffolding.
FOUNDRY_PROJECT_ENDPOINT="https://<YOUR-RESOURCE-NAME>.services.ai.azure.com/api/projects/<YOUR-PROJECT-NAME>"
FOUNDRY_VOICE_AGENT_MODEL="gpt-realtime"
# Optional: reuse a fixed agent name across runs instead of a new timestamped one each time.
FOUNDRY_VOICE_AGENT_NAME=""
# Optional: override the input/output audio file paths (default input: assets/input.pcm; default output: output.wav).
FOUNDRY_VOICE_AGENT_AUDIO_INPUT_FILE=""
FOUNDRY_VOICE_AGENT_AUDIO_OUTPUT_FILE=""
