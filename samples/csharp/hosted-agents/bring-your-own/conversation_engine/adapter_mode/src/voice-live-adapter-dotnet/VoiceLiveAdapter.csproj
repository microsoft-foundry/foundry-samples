<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VoiceHostedAgent</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);AAAS001</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;smoke/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.AgentServer.Invocations" Version="1.0.0-beta.8" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VoiceHostedAgent.Tests" />
  </ItemGroup>
</Project>
