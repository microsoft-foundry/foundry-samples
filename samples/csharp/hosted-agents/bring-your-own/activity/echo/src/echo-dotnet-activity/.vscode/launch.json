{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Echo Activity agent",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net10.0/echo.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PORT": "8088"
      }
    }
  ]
}
