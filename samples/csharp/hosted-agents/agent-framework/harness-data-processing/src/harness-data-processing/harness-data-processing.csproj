<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HarnessDataProcessing</RootNamespace>
    <AssemblyName>harness-data-processing</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      MAAI001 - Microsoft.Agents.AI experimental APIs (AsHarnessAgent, HarnessAgentOptions)
      OPENAI001 - OpenAI Responses experimental APIs (Foundry Responses hosting)
    -->
    <NoWarn>$(NoWarn);MAAI001;OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Agent Framework core - provides AIAgent and Microsoft.Extensions.AI types. -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.22.0" />
    <!-- Agent Framework harness - provides AsHarnessAgent, HarnessAgentOptions, FileAccessProvider, FileSystemAgentFileStore, ToolApprovalAgentOptions. -->
    <PackageReference Include="Microsoft.Agents.AI.Harness" Version="1.22.0" />
    <!-- Agent Framework hosting - provides AgentHost, AddFoundryResponses, MapFoundryResponses. -->
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.22.0-preview.260918.1" />
    <!-- Foundry SDK - provides AIProjectClient, GetProjectOpenAIClient, GetProjectResponsesClientForModel. -->
    <PackageReference Include="Azure.AI.Projects" Version="3.0.0-beta.2" />
    <!-- Azure Identity - DefaultAzureCredential. -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <!-- .env file support for local development. -->
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
  </ItemGroup>

  <!-- Ship the sample's CSV data files in the output so FileAccessProvider can read them. -->
  <ItemGroup>
    <Content Include="working\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
