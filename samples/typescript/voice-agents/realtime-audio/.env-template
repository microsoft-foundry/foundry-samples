# Standard Microsoft Foundry environment variable names, used for scaffolding.
FOUNDRY_PROJECT_ENDPOINT="https://<YOUR-RESOURCE-NAME>.services.ai.azure.com/api/projects/<YOUR-PROJECT-NAME>"

# Optional overrides. Sensible defaults are used when these are left unset:
# - FOUNDRY_VOICE_AGENT_NAME defaults to a generated unique name (a new agent is
#   created if the name does not already exist, and deleted again at the end of the run).
# - FOUNDRY_VOICE_AGENT_MODEL defaults to "gpt-realtime".
# - FOUNDRY_VOICE_AGENT_AUDIO_INPUT_FILE defaults to the checked-in ./assets/input.pcm fixture.
# - FOUNDRY_VOICE_AGENT_AUDIO_OUTPUT_FILE defaults to "./output.pcm".
FOUNDRY_VOICE_AGENT_NAME="<existing-or-new-voice-agent-name>"
FOUNDRY_VOICE_AGENT_MODEL="gpt-realtime"
FOUNDRY_VOICE_AGENT_AUDIO_INPUT_FILE="<path to a PCM16 24kHz mono audio input file>"
FOUNDRY_VOICE_AGENT_AUDIO_OUTPUT_FILE="<path to write streamed PCM audio output>"
