# Vite exposes only variables prefixed with VITE_ to browser code (import.meta.env).
# These are optional UI prefill values - the project endpoint can also be typed directly
# into the running app, and agents can be selected from a dropdown once connected.
VITE_FOUNDRY_PROJECT_ENDPOINT="https://<YOUR-RESOURCE-NAME>.services.ai.azure.com/api/projects/<YOUR-PROJECT-NAME>"
VITE_FOUNDRY_VOICE_AGENT_NAME="<existing-voice-agent-name>"
