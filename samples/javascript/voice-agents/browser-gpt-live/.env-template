# Vite exposes only variables prefixed with VITE_ to browser code (import.meta.env).
# These are optional UI prefill values - every field can also be typed into the running app.
VITE_FOUNDRY_PROJECT_ENDPOINT="https://<YOUR-RESOURCE-NAME>.services.ai.azure.com/api/projects/<YOUR-PROJECT-NAME>"

# The GPT-Live model deployment used when the app creates a temporary agent.
VITE_FOUNDRY_LIVE_MODEL="gpt-live-1"

# Optional Responses delegation deployment (for example "gpt-4.1"). Typed text input requires it.
VITE_FOUNDRY_DELEGATION_MODEL=""

# Optional existing GPT-Live agent name. Clear "Create a temporary agent" in the UI to connect to it.
VITE_FOUNDRY_VOICE_AGENT_NAME=""
