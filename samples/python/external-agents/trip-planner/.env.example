# Copy to .env and fill in. Don't commit .env.
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=<endpoint>
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_OPENAI_ENDPOINT=https://<account>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# Judge and analysis model for Insights, generation, evaluators, and skill optimization. Use GPT-5 or later.
JUDGE_MODEL_DEPLOYMENT=<gpt-5-deployment>
# Optional.
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# The agent's name in Foundry and the gen_ai.agent.id on its traces.
FOUNDRY_AGENT_NAME=contoso-trip-planner
OTEL_AGENT_ID=contoso-trip-planner
