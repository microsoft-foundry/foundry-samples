# Copy this file to .env and fill in all three values.
# Use the project endpoint copied from Microsoft Foundry.
AZURE_AI_PROJECT_ENDPOINT=""

# Use the connection name, not its display name or resource ID.
CONNECTED_MODEL_CONNECTION_NAME=""

# Use the model name/alias saved on the connection, not its display name.
# A gateway alias can itself contain a slash, such as provider/model-alias.
CONNECTED_MODEL_NAME=""
