# Microsoft Foundry Project Endpoint
# Format: https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
AZURE_AI_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>

# Model deployment name supporting the GA OpenAI Computer Tool (`computer`, e.g., gpt-5.4)
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4

# Optional: Prompt Agent name registered in Microsoft Foundry
AGENT_NAME=openai-computer-agent
