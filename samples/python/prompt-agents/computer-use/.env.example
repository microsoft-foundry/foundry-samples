# Azure AI Foundry Project Endpoint
# Format: https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
PROJECT_ENDPOINT="https://<your-resource>.services.ai.azure.com/api/projects/<your-project>"

# Model deployment name supporting the GA `computer` tool (e.g., gpt-5.4, gpt-5.5, gpt-5.6-sol)
MODEL_DEPLOYMENT_NAME="gpt-5.4"

# Optional: Prompt Agent name to register in Azure AI Foundry
AGENT_NAME="foundry-cua-prompt-agent"

# Optional: API key if not using DefaultAzureCredential (az login)
# OPENAI_API_KEY="your-api-key"
