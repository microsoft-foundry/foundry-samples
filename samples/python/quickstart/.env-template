# Standard Microsoft Foundry environment variable names.
# The quickstart samples hard-code their values, so copying this to .env won't
# change how they run. Use these names in your own applications.

FOUNDRY_PROJECT_ENDPOINT="https://<YOUR-RESOURCE-NAME>.services.ai.azure.com/api/projects/<YOUR-PROJECT-NAME>"
FOUNDRY_AGENT_NAME="MyAgent"
FOUNDRY_MODEL_DEPLOYMENT="gpt-5-mini"
