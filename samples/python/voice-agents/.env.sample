# Standard Microsoft Foundry environment variable names for the Voice Agents samples.
# Copy this file to .env in this folder and fill in your own values.

# Required by every sample.
# Format: "https://<resource-name>.services.ai.azure.com/api/projects/<project-name>"
FOUNDRY_PROJECT_ENDPOINT="https://<YOUR-RESOURCE-NAME>.services.ai.azure.com/api/projects/<YOUR-PROJECT-NAME>"

# Leave blank for each sample's compatible managed model default (usually gpt-realtime).
# BYOM uses an existing deployment name instead, with model_type=self_deployed.
FOUNDRY_VOICE_AGENT_MODEL=""

# Leave blank for a unique new agent in creating samples. For readback, image,
# and telephony samples, set the name of your existing agent.
FOUNDRY_VOICE_AGENT_NAME=""

# Optional. Used only by voice_agent_with_tools.py. "managed" (default)
# for a service-hosted model, or "self_deployed" to bring your own Foundry
# deployment.
FOUNDRY_VOICE_MODEL_TYPE="managed"

# Optional. Used only by voice_agent_read_conversation.py and
# voice_agent_read_conversation_audio.py. The id of an existing
# persisted conversation to read back. If unset, those samples hold a short
# realtime turn first to produce one.
FOUNDRY_VOICE_CONVERSATION_ID=""

# Required only by voice_agent_realtime_image_conversation.py.
FOUNDRY_VOICE_AGENT_IMAGE_PATH="<path-to-jpeg-png-or-webp>"

# Optional. Used only by voice_agent_realtime_image_conversation.py.
FOUNDRY_VOICE_AGENT_IMAGE_PROMPT="What is shown in this image?"

# Optional external tools for voice_agent_with_tools.py. Use your own resources.
FOUNDRY_VOICE_MCP_SERVER_URL=""
FOUNDRY_VOICE_MCP_TOOL_NAME=""
FOUNDRY_VOICE_TOOLBOX_NAME=""
FOUNDRY_VOICE_TOOLBOX_VERSION=""

# Required by voice_agent_subagents.py: an existing chat model deployment.
FOUNDRY_VOICE_SUBAGENT_MODEL=""

# Optional existing directory for the Realtime audio readers.
FOUNDRY_VOICE_AUDIO_OUTPUT_DIR=""

# Managed cascaded/interim audio recipes; these are model IDs, not new deployments.
FOUNDRY_VOICE_TEXT_MODEL=""
FOUNDRY_VOICE_INTERIM_MODEL=""
FOUNDRY_VOICE_LANGUAGE="en-US"
FOUNDRY_VOICE_PHRASES="Foundry,Contoso"
FOUNDRY_VOICE_NOISE_REDUCTION=""
# Required only by the custom-speech audio recipe; no resource is provisioned.
FOUNDRY_VOICE_CUSTOM_SPEECH_ENDPOINT_ID=""

# Native GPT Live: existing deployments, not new model resources.
FOUNDRY_VOICE_LIVE_MODEL=""
# Required by Live text and managed delegation: an existing chat deployment.
FOUNDRY_MODEL_NAME=""
# Spoken, uncompressed PCM16 mono 24000-Hz WAV, at most 30 seconds.
FOUNDRY_VOICE_AUDIO_INPUT_PATH=""
# Optional new output paths; unset/blank uses unique filenames.
FOUNDRY_VOICE_LIVE_OUTPUT_PATH=""
FOUNDRY_VOICE_LIVE_RECORDING_PATH=""
# Read-only Live readback uses these IDs, separate from Realtime storage.
FOUNDRY_VOICE_LIVE_AGENT_NAME=""
FOUNDRY_VOICE_LIVE_CONVERSATION_ID=""

# Avatar WebSocket output: an available character and optional style.
FOUNDRY_VOICE_AVATAR_CHARACTER=""
FOUNDRY_VOICE_AVATAR_STYLE=""
FOUNDRY_VOICE_ANIMATION_MODEL=""

# Telephony: existing same-project resources and authorized test addresses.
# Scripts require explicit --place-call / --schedule-campaign / --run / --create-agent.
FOUNDRY_TELEPHONY_CONNECTION_NAME=""
FOUNDRY_TELEPHONY_SOURCE=""
FOUNDRY_TELEPHONY_DESTINATION=""
FOUNDRY_TELEPHONY_TRANSFER_DESTINATION=""
FOUNDRY_TELEPHONY_SMS_NUMBER=""
