# Foundry A365 Agent — Python sample environment template
#
# Copy this file to `.env` (next to `main.py`) and fill in the values to run
# the agent locally with `python -m hello_world_a365_agent`.
#
# In production, dynamic values are injected when the hosted agent version is
# created — you do not need a `.env` file at runtime.
#
# IMPORTANT: env-var names must be ALL-CAPS and use `SERVICE_CONNECTION`
# (single underscore inside the connection name). The Python
# `load_configuration_from_env` helper splits on `__` and stores the leaves
# verbatim, and the MSAL connection manager looks up the literal key
# `SERVICE_CONNECTION` inside `CONNECTIONS`. The C#-style mixed-case
# `Connections__ServiceConnection__Settings__*` names from appsettings.json
# do NOT work on Linux/Python.

# ── Microsoft Foundry ───────────────────────────────────────────────────────
FOUNDRY_PROJECT_ENDPOINT=
ModelDeployment=gpt-5-chat
FOUNDRY_AGENT_NAME=FoundryDigitalWorker
# Optional stable ID used by the custom invoke_agent span; defaults to the name.
FOUNDRY_AGENT_ID=
# Consumer endpoint for the Foundry Toolbox created during provisioning.
TOOLBOX_ENDPOINT=

# ── Microsoft 365 Agents SDK service connection (the Connections section in appsettings.json) ──
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE=IdentityProxyManager
# The hosted runtime maps FOUNDRY_AGENT_BLUEPRINT_CLIENT_ID to this setting.
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHORITY=https://login.microsoftonline.com/<TENANT_ID>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=<TENANT_ID>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__SCOPES__0=5a807f24-c9de-44ee-a3a7-329e88a00ffc/.default

CONNECTIONSMAP__0__SERVICEURL=*
CONNECTIONSMAP__0__CONNECTION=SERVICE_CONNECTION

# ── Agentic auth handler (the AgentApplication section in appsettings.json) ──
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AGENTIC__SETTINGS__TYPE=AgenticUserAuthorization

AUTH_HANDLER_NAME=AGENTIC

# ── Azure DevOps remote MCP server (optional) ───────────────────────────────
# Azure DevOps organization name only, for example "contoso".
AZURE_DEVOPS_ORGANIZATION=

# ── Hosted Agents runtime ───────────────────────────────────────────────────
MCP_PLATFORM_ENDPOINT=https://agent365.svc.cloud.microsoft
FOUNDRY_AGENT_BLUEPRINT_CLIENT_ID=
FOUNDRY_AGENT_DEFAULT_INSTANCE_CLIENT_ID=

# ── Application Insights ────────────────────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=
# GenAI tracing and message capture default to true when Application Insights
# is configured. Override either setting here if content capture is not allowed.
AZURE_EXPERIMENTAL_ENABLE_GENAI_TRACING=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# ── Key Vault (optional) ────────────────────────────────────────────────────
# When set, secrets are loaded into environment variables on startup.
KEY_VAULT_NAME=

# ── HTTP server ─────────────────────────────────────────────────────────────
PORT=8088
HOST=0.0.0.0
LOG_LEVEL=INFO
