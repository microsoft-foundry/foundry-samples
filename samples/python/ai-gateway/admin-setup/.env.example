# Copy this file to .env and set the values. Don't put keys or other secrets in it.

# Gateway (all steps)
AZURE_SUBSCRIPTION_ID=""
AI_GATEWAY_RESOURCE_GROUP=""
# 3-24 lowercase letters, digits, and hyphens.
AI_GATEWAY_NAME=""
AI_GATEWAY_LOCATION="eastus2"

# Existing Foundry account and model deployment in the same subscription (steps 2-4)
FOUNDRY_RESOURCE_GROUP=""
FOUNDRY_ACCOUNT_NAME=""
FOUNDRY_MODEL_DEPLOYMENT="gpt-5-mini"

# Model name that callers send in the request "model" field. Leave empty to use the deployment name.
AI_GATEWAY_ALIAS=""
# Tokens per minute that each caller identity can use through the alias.
AI_GATEWAY_TOKENS_PER_MINUTE="10000"

# Existing Foundry project that gets keyless access (step 3)
FOUNDRY_PROJECT_NAME=""
AI_GATEWAY_CONNECTION_NAME="ai-gateway"

# Runtime API key for an application outside Foundry (optional step 4)
AI_GATEWAY_API_KEY_NAME="external-app"
