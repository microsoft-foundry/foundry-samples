# Enable Claude Agent SDK to use Microsoft Foundry.
CLAUDE_CODE_USE_FOUNDRY=1

# Required value for startup.
# ANTHROPIC_MODEL=claude-opus-4-7

# --- Optional: consume an existing Foundry Toolbox --------------------------
# This sample only *consumes* an already-provisioned toolbox; it does not
# create or configure one. Provision the toolbox separately (e.g. via
# `azd ai toolbox create`) before setting either variable below.

# Toolbox MCP endpoint — the full URL the agent connects to.
# Example: https://<account>.services.ai.azure.com/api/projects/<project>/toolboxes/my-toolbox/versions/1/mcp?api-version=v1
# TOOLBOX_ENDPOINT=

# Alternative to TOOLBOX_ENDPOINT: just the toolbox name. The agent builds the
# "latest" endpoint from FOUNDRY_PROJECT_ENDPOINT + TOOLBOX_NAME. Ignored if
# TOOLBOX_ENDPOINT is set.
# TOOLBOX_NAME=my-toolbox

# Required whenever TOOLBOX_ENDPOINT/TOOLBOX_NAME is set: a comma-separated,
# explicit allowlist of toolbox tool names to expose to the model. Every name
# here must also be returned by the toolbox's own tool discovery, or the
# invocation fails at request time. Tools the toolbox exposes but that are NOT
# listed here (e.g. write/mutating tools) are never callable. There is no
# "allow everything discovered" default.
# TOOLBOX_ALLOWED_TOOLS=web_search

# Application Insights is auto-injected in hosted containers.
# Set this for local telemetry if desired.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
