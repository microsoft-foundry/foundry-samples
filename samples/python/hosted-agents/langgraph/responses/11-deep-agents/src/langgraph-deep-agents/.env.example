# Foundry project endpoint - auto-injected in hosted containers.
# Only set manually if running without `azd ai agent run`.
FOUNDRY_PROJECT_ENDPOINT=

# Model deployment name - must match a deployment in your Foundry project.
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# Name of the Foundry Toolbox declared in azure.yaml.
TOOLBOX_NAME=deep-agents-tools

REPORT_STORAGE_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net
REPORT_STORAGE_CONTAINER=reports

# Optional for local telemetry export; hosted Foundry supplies the connection.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Sensitive message content is opt-in; INFO logs and tracing are enabled.
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=false
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
