FOUNDRY_PROJECT_ENDPOINT="..."
AZURE_AI_MODEL_DEPLOYMENT_NAME="..."
# Set the deployment input to the versioned endpoint returned by:
# azd env get-value TOOLBOX_AGENT_TOOLS_MCP_ENDPOINT
