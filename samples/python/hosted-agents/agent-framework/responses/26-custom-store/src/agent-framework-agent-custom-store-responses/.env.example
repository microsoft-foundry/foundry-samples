FOUNDRY_PROJECT_ENDPOINT="..."
AZURE_AI_MODEL_DEPLOYMENT_NAME="..."

# All four custom stores share one Redis instance. For direct `python main.py`
# runs, REDIS_URL selects the local Docker Redis. When deployed, this file is
# excluded and `azd` injects REDIS_HOST / REDIS_PORT for Azure Managed Redis;
# the agent then connects passwordless with its managed identity
# (DefaultAzureCredential).
REDIS_URL=redis://localhost:6379/0
# Identity used to partition local, unhosted requests.
LOCAL_STORE_USER_ID=local-developer
# Retention window applied to Responses store writes.
REDIS_RESPONSE_TTL_SECONDS=86400